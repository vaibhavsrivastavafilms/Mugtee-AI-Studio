# Mugtee AI Studio — environment variables (names only; no secrets)
# Copy to .env.local for local development: cp .env.example .env.local

# --- Public (embedded in client bundle at build time) ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_EMAIL_AUTH=false

# Optional public integrations
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# AI / media providers
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
POLLINATIONS_API_KEY=

# Video / render
VIDEO_RENDER_ENABLED=false
VIDEO_RENDER_MOCK=true
SHOW_ON_SCREEN_TEXT=true

# Music / TTS (optional)
MVP_ROYALTY_FREE_MUSIC_URL=
PIPER_BIN=
PIPER_MODEL_PATH=

# Billing / OAuth (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
YOUTUBE_REDIRECT_URI=
OPENART_REDIRECT_URI=

# Dev / smoke
V7_SMOKE_USER_ID=
FREE_TIER_ONLY=true
