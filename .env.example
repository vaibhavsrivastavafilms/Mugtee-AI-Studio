# =============================================================================
# Mugtee AI Studio — environment variables
# Copy to .env.local for local dev. Set the same keys in Vercel → Project → Settings → Environment Variables.
# NEVER commit .env.local.
# =============================================================================

# --- Site / deployment ---
# NEXT_PUBLIC_BASE_URL=https://mugtee.in
# NEXT_PUBLIC_APP_URL=https://mugtee.in
# NEXT_OUTPUT_STANDALONE=1          # Docker/Linux self-hosted only (disabled on Vercel + Windows builds)

# =============================================================================
# Quick Cut FREE TIER (recommended for local dev)
# =============================================================================
# Set FREE_TIER_ONLY=true to block paid providers (Claude, DALL-E, ElevenLabs,
# Emergent gateway). Pipeline still runs end-to-end with mocks when keys are missing.
#
# Minimum for live free generation:
#   GEMINI_API_KEY — https://aistudio.google.com/apikey (script + research)
#   FLUXAPI_KEY — https://fluxapi.ai/ (Flux Kontext scene images; preferred when set)
#   TOGETHER_API_KEY — https://api.together.xyz/ (FLUX.1-schnell fallback; Pollinations if unset)
#
# Optional (still low-cost; not required for free-only):
#   PERPLEXITY_API_KEY — Sonar deep research (preferred when set)
#   OPENAI_API_KEY — gpt-4o-mini script generation + tts-1 voice
# =============================================================================

FREE_TIER_ONLY=true

# Google AI Studio (free tier) — script generation via generativelanguage.googleapis.com
GEMINI_API_KEY=REDACTED_GEMINI_API_KEY
# GOOGLE_API_KEY=              # alias for GEMINI_API_KEY
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# FluxAPI.ai — FLUX.1 Kontext [dev] scene images (async REST API); tried first when set
# Product: https://fluxapi.ai/flux-1-kontext-dev-api
# API docs: https://docs.fluxapi.ai/quickstart
# Alias key name: FLUX_API_KEY
# FLUXAPI_MODEL=flux-kontext-pro          # or flux-kontext-max for complex scenes
# FLUXAPI_ASPECT_RATIO=9:16               # reels; also 16:9, 1:1, 3:4, 4:3, 21:9, 16:21
# FLUXAPI_PROMPT_UPSAMPLING=false         # set true to let API enhance short prompts
FLUXAPI_KEY=

# V7 image orchestrator — SDXL slot (Together or Stability)
# V7_SDXL_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# STABILITY_API_KEY=

# V7 image orchestrator — ComfyUI slot (local or remote)
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors

# Together AI — scene images (FLUX.1-schnell); Pollinations used when FluxAPI/Together fail or unset
# https://api.together.xyz/
TOGETHER_API_KEY=

# Perplexity Sonar — cinematic deep research (used before OpenAI/Gemini when set)
# https://docs.perplexity.ai/
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar-pro

# OpenAI ChatGPT — cinematic script generation (preferred when set; not used for research if Perplexity is set)
# Local dev: return deterministic mock script when all AI providers fail (pipeline keeps running)
SCRIPT_GENERATION_MOCK=true
# AI_MOCK_MODE=true
# MOCK_AI=true
# AI_SCRIPT_MOCK_FALLBACK=true   # legacy alias for SCRIPT_GENERATION_MOCK
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1   # optional paid fallback when Together/Pollinations fail

# =============================================================================
# AI Provider Routing (Phase 1 — multi-provider text generation)
# =============================================================================
# At least one key above enables live hook/script generation via lib/ai/providers/.
# When unset, defaults pick the first available key per task (see docs/AI_PROVIDER_MIGRATION.md).
#
# GROQ_API_KEY=REDACTED_GROQ_API_KEY                    # https://console.groq.com/ — fast hook fallback
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=REDACTED_OPENROUTER_API_KEY              # https://openrouter.ai/ — unified model gateway
# OPENROUTER_MODEL=qwen/qwen3-235b-a22b
# OPENROUTER_SCRIPT_MODEL=deepseek/deepseek-chat-v3-0324
# DEEPSEEK_API_KEY=REDACTED_DEEPSEEK_API_KEY              # https://platform.deepseek.com/
# DEEPSEEK_MODEL=deepseek-chat
#
# --- Mugtee V7 text generation (open-source stack; Gemini NOT used) ---
# Priority: Ollama (local) → Groq (free) → OpenRouter Qwen → OpenRouter DeepSeek → Together
# Research/script agents prefer Qwen 3 → DeepSeek V3 → Llama (Groq).
# V7_OPENROUTER_MODEL=qwen/qwen3-235b-a22b
# V7_OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat-v3-0324
# V7_GROQ_MODEL=llama-3.3-70b-versatile
# V7_GROQ_FALLBACK_MODEL=deepseek-r1-distill-llama-70b
# V7_TOGETHER_MODEL=Qwen/Qwen2.5-72B-Instruct-Turbo
# OLLAMA_HOST=http://localhost:11434
# V7_OLLAMA_ENABLED=true
# V7_OLLAMA_MODEL=qwen3
# V7_TEXT_USE_GEMINI=false        # ignored — Gemini disabled for V7
# V7_TEXT_MAX_TOKENS=4096
# V7_PROVIDER_DEBUG=true          # verbose provider failure logs in dev
#
# OpenRouter requires purchased credits for paid models (402 if balance is zero).
# Add GROQ_API_KEY (free tier at console.groq.com) as fallback when OpenRouter is exhausted.
#
# Per-task routing (provider ids: openai | gemini | groq | openrouter | deepseek):
# AI_PROVIDER_RESEARCH_PRIMARY=groq
# AI_PROVIDER_SCRIPT_PRIMARY=groq
# AI_PROVIDER_HOOK_PRIMARY=groq
# AI_PROVIDER_HOOK_FALLBACK=gemini
# AI_PROVIDER_SCRIPT_FALLBACK=openrouter
# AI_PROVIDER_TITLE_PRIMARY=gemini
# AI_PROVIDER_CAPTION_PRIMARY=groq
# =============================================================================

# --- Open-source voice (local, zero cost) ---
# Kokoro — OpenAI-compatible local TTS server (e.g. kokoro-fastapi)
# KOKORO_TTS_URL=http://localhost:8880
# KOKORO_MODEL=kokoro
# KOKORO_VOICE=af_heart
#
# Piper — CLI local TTS (https://github.com/rhasspy/piper)
# PIPER_BIN=piper
# PIPER_MODEL_PATH=/path/to/en_US-lessac-medium.onnx
#
# Voice cascade: Kokoro → Piper → OpenAI TTS → Google TTS → silent fallback
# ElevenLabs only when FREE_TIER_ONLY=false and key is set.

# --- Open-source music & sound (local HTTP services) ---
# MusicGen — POST JSON { prompt, duration } → audio URL or binary
# MUSICGEN_URL=http://localhost:8090/generate
# MUSICGEN_PROMPT=cinematic ambient background music
# MVP_ROYALTY_FREE_MUSIC_URL=   # fallback when MusicGen unavailable
#
# AudioGen — POST JSON { prompt, duration } → SFX clip URL or binary
# AUDIOGEN_URL=http://localhost:8091/generate
#
# --- Open-source scene video (V7 Scene Media stage) ---
# Provider order: Wan → HunyuanVideo → CogVideoX → LTX → Mochi → AnimateDiff → Image Animation (FFmpeg)
# Each endpoint accepts POST JSON { prompt, imageUrl, durationSec, width, height, seed, continuityId }
# and returns JSON { videoUrl } or raw MP4 bytes.
# WAN_VIDEO_URL=http://localhost:7860/generate
# WAN_VIDEO_API_KEY=
# HUNYUAN_VIDEO_URL=
# COGVIDEOX_VIDEO_URL=
# LTX_VIDEO_URL=
# MOCHI_VIDEO_URL=
# ANIMATEDIFF_VIDEO_URL=
# Image Animation (last resort) uses FFmpeg + storyboard still when no AI video endpoint is configured.

# --- Paid providers (ignored when FREE_TIER_ONLY=true) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# EMERGENT_LLM_KEY=
# EMERGENT_API_BASE=
# EMERGENT_GEMINI_IMAGE_MODEL=gemini/gemini-2.5-flash-image
# ElevenLabs — cinematic voiceover (Quick Cut Voice tab + /api/generate-voice)
# https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=              # required for ElevenLabs TTS (not sk_openai-style keys)
# Aliases also accepted: ELEVENLABS_KEY, ELEVEN_API_KEY, XI_API_KEY
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# On Vercel: set FREE_TIER_ONLY=false (or remove it) when using ElevenLabs.
REPLICATE_API_TOKEN=
# Director Mode image-to-video (stable-video-diffusion via Replicate)
VIDEO_PROVIDER=replicate
# REPLICATE_SVD_VERSION=3f0457e4619daac51203dedb1a4f47f3442e0fff4369654e8bfc5fd87094c4d2

# Supabase (required for auth + asset storage — must also be set in Vercel project env)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=          # legacy JWT anon key or sb_publishable_* key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # alias accepted by middleware if ANON_KEY is unset
# NEXT_PUBLIC_SUPABASE_EMAIL_AUTH=true    # enable /auth/forgot-password (Supabase email provider required)
# SUPABASE_SERVICE_ROLE_KEY=

# Video render (optional — copy to .env.local; never commit secrets)
# Dev: VIDEO_RENDER_MOCK lightens encode settings and uses FFmpeg Ken Burns from REAL storyboard stills.
# It never writes a black stub. Production should set VIDEO_RENDER_ENABLED=true (Remotion).
# VIDEO_RENDER_ENABLED=true          # Remotion + FFmpeg MP4 export (production)
VIDEO_RENDER_MOCK=true             # local FFmpeg stills encode (requires ffmpeg-static)
# NEXT_PUBLIC_VIDEO_RENDER_MOCK=true # optional client override (mirrors VIDEO_RENDER_MOCK)
REMOTION_CONCURRENCY=1               # parallel Chromium tabs (required for local 1080x1920 renders)
# REMOTION_PARALLEL_ENCODING=false   # leave unset — parallel encoding disabled by default (saves RAM)
# REMOTION_OFFTHREAD_CACHE_MB=128    # cap Remotion offthread video frame cache
# FFMPEG_PATH=
# FFMPEG_BIN=
# When set, compile uses Runway Gen-4.5 image-to-video per scene (FFmpeg still assembles final MP4).
# RUNWAY_API_KEY=                    # https://dev.runwayml.com/ — alias: RUNWAYML_API_SECRET
# RUNWAY_MODEL=gen4.5
# VIDEO_RENDER_PROVIDER=auto         # auto | runway | ffmpeg
# CINEMATIC_RENDER_PROVIDER=

# Seedance SD 2.0 — per-scene AI video clips (Quick Cut pipeline, separate from MP4 compile)
# https://seedanceapi.org/docs/v2 — get key from dashboard; never commit real values
SEEDANCE_API_KEY=
# SEEDANCE_API_BASE=https://seedanceapi.org/v2   # optional override
# SEEDANCE_MODEL=seedance-2.0                    # or seedance-2.0-fast
# VIDEO_GENERATION_ENABLED=true                  # force on/off scene clip generation
# VIDEO_GENERATION_PROVIDER=seedance
# MUGTEE_LIMIT_DAILY_VIDEOS=10
# MUGTEE_LIMIT_MONTHLY_VIDEOS=50

# Script quality gates (optional)
# SCRIPT_SOP_MIN_SCORE=
# SCRIPT_SOP_MAX_RETRIES=

# --- Auth integrations ---
# YouTube OAuth (Settings → Integrations)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=              # defaults to {NEXT_PUBLIC_BASE_URL}/api/youtube/callback

# Instagram / Meta OAuth
# META_APP_ID=
# META_APP_SECRET=
# INSTAGRAM_APP_ID=                  # alias for META_APP_ID
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_ACCESS_TOKEN=

# --- Notion (content calendar sync at /calendar) ---
# Create an internal integration at https://www.notion.so/my-integrations
# Share your calendar database with the integration, then copy its database ID from the URL.
# NOTION_API_KEY=                      # alias: NOTION_TOKEN
# NOTION_CALENDAR_DATABASE_ID=
# Optional property names if your database uses different column titles:
# NOTION_PROP_TITLE=Name
# NOTION_PROP_PLATFORM=Platform
# NOTION_PROP_STATUS=Status
# NOTION_PROP_SCHEDULED=Scheduled
# NOTION_PROP_DESCRIPTION=Description
# NOTION_PROP_MUGTEE_ID=Mugtee ID

# --- Buffer (social post queue from Pipeline + Publish Center) ---
# Create an access token at https://buffer.com/developers/apps
# BUFFER_ACCESS_TOKEN=                 # aliases: BUFFER_API_KEY, BUFFER_TOKEN
# BUFFER_PROFILE_ID=                   # optional default channel id

# --- Billing (Razorpay) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_CREATOR_ID=
# RAZORPAY_PLAN_AGENCY_ID=
# RAZORPAY_CREATOR_AMOUNT_PAISE=59900
# RAZORPAY_PRO_AMOUNT_PAISE=99900
# NEXT_PUBLIC_SOCIAL_PROOF_LIVE=false

# --- Analytics & ads ---
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_ADSENSE_CLIENT=

# --- Export entitlement (dev / QA) ---
# Bypass Pro plan, subscription, and export/render usage caps (NODE_ENV=development also unlocks).
NEXT_PUBLIC_DEV_UNLOCK_EXPORT=true

# --- Usage limits (Phase 4 monetization validation) ---
