# MUGTEE_CREATOR_LIMIT_EXPORTS=5
# MUGTEE_PRO_LIMIT_GENERATIONS=100
# MUGTEE_PRO_LIMIT_EXPORTS=20
# MUGTEE_STUDIO_LIMIT_GENERATIONS=300
# MUGTEE_STUDIO_LIMIT_EXPORTS=50
# MUGTEE_CREATOR_LIMIT_PROJECTS=25
# MUGTEE_CREATOR_LIMIT_GENERATIONS=100
# MUGTEE_CREATOR_LIMIT_EXPORTS=15
# MUGTEE_CREATOR_LIMIT_RENDERS=15
# MUGTEE_PRO_LIMIT_PROJECTS=100
# MUGTEE_PRO_LIMIT_GENERATIONS=500
# MUGTEE_PRO_LIMIT_EXPORTS=50
# MUGTEE_PRO_LIMIT_RENDERS=50

# --- Creator Referral Program (Phase 3.5) ---
# NEXT_PUBLIC_BASE_URL=https://mugtee.in   # used for /invite/{code} links
# MUGTEE_REFERRAL_BONUS_1=10               # generations bonus at 1 signup
# MUGTEE_REFERRAL_BONUS_5=50               # at 5 signups
# MUGTEE_REFERRAL_BONUS_10=50              # at 10 signups (+ Creator Plan Bonus flag)
# MUGTEE_REFERRAL_CREATOR_GENERATIONS=200  # extended cap when 10-referral bonus active

# --- Live Companion (Story Companion at /home — default off) ---
# NEXT_PUBLIC_COMPANION_ENABLED=false
# NEXT_PUBLIC_COMPANION_EXPERIMENTAL_VOICE=false   # hands-free, mugtee-os floating STT
# COMPANION_EXPERIMENTAL_VOICE=false
# BETA_TESTER_USER_IDS=              # companion access when public flag is off
# BETA_TESTER_EMAILS=

# --- Admin (Founder Dashboard at /admin — Phase 8 revenue metrics) ---
# ADMIN_USER_IDS=                    # comma-separated Supabase user UUIDs
# ADMIN_EMAILS=
# Run supabase/migrations/0031_revenue_events.sql for pricing visits / upgrade funnel counts.

# --- Sales / contact ---
# NEXT_PUBLIC_AGENCY_WHATSAPP=

# --- Legacy Mongo catch-all API (app/api/[[...path]]) ---
# MONGO_URL=
# DB_NAME=
# CORS_ORIGINS=*
